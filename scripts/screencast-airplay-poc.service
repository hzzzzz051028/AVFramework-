[Unit]
Description=RK Screencast AirPlay Receiver (POC)
After=network-online.target avahi-daemon.service screencast-display-console.service
Wants=network-online.target avahi-daemon.service screencast-airplay-display-watch.service

[Service]
Type=simple
# UxPlay stays online for mDNS discovery.  The companion watcher uses UxPlay's
# transient DACP file to reserve HDMI only while a client is actually joined.
Environment=GST_PLUGIN_PATH=/opt/screencast/vendor/gstreamer-rockchip/lib/gstreamer-1.0
Environment=LD_LIBRARY_PATH=/opt/screencast/vendor/mpp/lib
ExecStartPre=/usr/bin/install -d -m 0755 /run/screencast
ExecStartPre=/usr/bin/rm -f /run/screencast/display-exclusive-active /run/screencast/airplay-client
# Native NV12 is supported by the RK MPP decoder and KMS plane.  Keep the
# compressed stream intact and skip UxPlay's default RGB/sRGB round-trip.
ExecStart=/opt/screencast/vendor/uxplay/bin/uxplay -d 1 -FPSdata -n RK-Cast-Native -nh -s 2560x1440@60 -fps 60 -vsync no -srgb no -vc identity -as 0 -dacp /run/screencast/airplay-client -vd mppvideodec -vs "kmssink plane-id=71 sync=false"
ExecStopPost=/usr/bin/rm -f /run/screencast/display-exclusive-active
ExecStopPost=/usr/bin/rm -f /run/screencast/airplay-client
ExecStopPost=/usr/bin/systemctl start screencast-standby.service
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=screencast-airplay

[Install]
# This is deliberately not enabled by default: AirPlay and WebRTC currently
# share one KMS plane and the display arbiter is a later integration task.
WantedBy=multi-user.target

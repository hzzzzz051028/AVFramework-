[Unit]
Description=Wireless Display clean HDMI console
After=local-fs.target systemd-udev-settle.service
Before=screencast.service screencast-standby.service

[Service]
Type=oneshot
# tty2 is deliberately never assigned a login shell.  It is the permanent
# background below the KMS video/standby overlay, so no Linux prompt can leak
# into unused areas of a non-fullscreen source frame.
ExecStartPre=/usr/bin/systemctl mask --runtime autovt@tty2.service
ExecStartPre=-/usr/bin/systemctl stop autovt@tty2.service
ExecStart=/usr/bin/chvt 2
ExecStart=/bin/sh -c 'TERM=linux /usr/bin/setterm --clear all --cursor off </dev/tty2 >/dev/tty2 2>&1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
